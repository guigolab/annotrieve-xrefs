# Optional NCBI E-utilities key (10 req/s). Without it the API uses ~2.5 req/s.
# Never commit a real key. Copy to .env (gitignored) on the host.
NCBI_API_KEY=
NCBI_EMAIL=annotrieve-xrefs@crg.eu
NCBI_TOOL=annotrieve-xrefs

# Optional: strip this harvest --files-root prefix when rebasing gff_path.
# ANNOTATIONS_GFF_PATH_PREFIX=/data/annotrieve/files

# CORS (comma-separated). Empty → allow *.
# CORS_ALLOWED_ORIGINS=https://genome.crg.es
